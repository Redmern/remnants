<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Remnants.Game</RootNamespace>
    <AssemblyName>Remnants.Game</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Remnants.Core\Remnants.Core.csproj" />
    <ProjectReference Include="..\src\Remnants.Net\Remnants.Net.csproj" />
  </ItemGroup>
  <!-- Exported builds cannot reach ../data, so the definitions ship inside the assembly (see GameDataPaths). -->
  <Import Project="..\EmbeddedData.props" />
</Project>
