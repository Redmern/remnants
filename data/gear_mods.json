{
  // Gear mods and Mk upgrades for weapons, armor and clothing (ARCHITECTURE.md "Gear mods", BALANCE.md "Gear mods").
  // A modded item is an ordinary item id: base[@quality][+mk2|+mk3][+mod[@quality]]..., mods in slot order, so it
  // travels through inventories, expeditions, saves, trades and the wire as itself. Schematics that gate the recipes
  // below are in schematics.gearmods.json.
  "rules": {
    // Buildings with a Gear Bench (install / remove mods) and those that fit Mk kits.
    "benches": ["armory", "workshop", "tailor"],
    "upgradeAt": ["armory", "tailor"],
    // Fitting or removing a mod in the field needs this perk hook (Jury-rig) and costs AP.
    "fieldHook": "field_repair",
    "fieldApCost": 2,
    // A ranged attack after moving this turn loses accuracy (a stock takes some of it away). The Linked and
    // machines aim on the move.
    "movedAccuracyPenalty": 0.06,
    "movedPenaltyIgnoredBy": ["Linked", "Device"],
    // The environment is dark for a weapon light or thermal masking when human sight is cut below this multiplier.
    "darkBelowSight": 0.95
  },

  "slots": [
    { "id": "sight", "name": "Sight" },
    { "id": "muzzle", "name": "Barrel / muzzle" },
    { "id": "stock", "name": "Stock / grip" },
    { "id": "underbarrel", "name": "Underbarrel" },
    { "id": "edge", "name": "Edge / head" },
    { "id": "grip", "name": "Grip" },
    { "id": "coil", "name": "Coil" },
    { "id": "plating", "name": "Plating" },
    { "id": "lining", "name": "Lining" },
    { "id": "outer", "name": "Outer layer" },
    { "id": "webbing", "name": "Webbing" },
    { "id": "visor", "name": "Visor / filter" }
  ],

  // Slot kinds per gear type and how many may be filled at Mk I / II / III.
  "types": {
    "firearm": { "slots": ["sight", "muzzle", "stock", "underbarrel"], "slotsByMark": [2, 3, 4] },
    "melee": { "slots": ["edge", "grip", "coil"], "slotsByMark": [1, 2, 3] },
    "integrated": { "slots": ["sight", "muzzle", "underbarrel"], "slotsByMark": [1] },
    "armor": { "slots": ["plating", "lining", "outer", "webbing"], "slotsByMark": [2, 3, 4] },
    "clothing": { "slots": ["lining", "outer", "webbing"], "slotsByMark": [2, 3, 3] },
    "helmet": { "slots": ["plating", "lining", "visor"], "slotsByMark": [1, 2, 3] },
    "mask": { "slots": ["visor"], "slotsByMark": [1] }
  },

  "gear": {
    "pistol": { "type": "firearm", "family": "sidearm" },
    "rifle": { "type": "firearm", "family": "longarm" },
    "linked_carbine": { "type": "firearm", "family": "carbine" },
    "pipe": { "type": "melee", "family": "melee" },
    "spear": { "type": "melee", "family": "melee" },
    "machete": { "type": "melee", "family": "melee" },
    "gun_arm": { "type": "integrated" },
    "rag_coat": { "type": "clothing", "family": "clothing" },
    "scout_jacket": { "type": "clothing", "family": "clothing" },
    "camo_cloak": { "type": "clothing", "family": "clothing" },
    "padded_vest": { "type": "armor", "family": "armor" },
    "riot_armor": { "type": "armor", "family": "armor" },
    "linked_plating": { "type": "armor", "family": "plating" },
    "helmet_scrap": { "type": "helmet", "family": "armor" },
    "helmet_riot": { "type": "helmet", "family": "armor" },
    "gas_mask": { "type": "mask" }
  },

  // Base stat steps of the Mk upgrades; they stack with quality. Weapons take the damage and accuracy, worn gear the
  // armor (base + armorBonus, then × armorMultiplier) and coverage (added to each region it covers, up to 1).
  "marks": [
    { "mk": 2, "name": "Mk II", "damageMultiplier": 1.12, "accuracyBonus": 0.03, "armorBonus": 0.5, "armorMultiplier": 1.15,
      "coverageBonus": 0.15, "weightMultiplier": 1.05 },
    { "mk": 3, "name": "Mk III", "damageMultiplier": 1.25, "accuracyBonus": 0.06, "armorBonus": 1, "armorMultiplier": 1.3,
      "coverageBonus": 0.3, "weightMultiplier": 1.1 }
  ],

  // Upgrade kit item per gear family and mark.
  "families": {
    "sidearm": { "name": "Sidearm", "kits": { "2": "kit_sidearm_mk2", "3": "kit_sidearm_mk3" } },
    "longarm": { "name": "Long gun", "kits": { "2": "kit_longarm_mk2", "3": "kit_longarm_mk3" } },
    "carbine": { "name": "Linked carbine", "kits": { "2": "kit_carbine_mk2", "3": "kit_carbine_mk3" } },
    "melee": { "name": "Melee", "kits": { "2": "kit_melee_mk2", "3": "kit_melee_mk3" } },
    "clothing": { "name": "Clothing", "kits": { "2": "kit_clothing_mk2", "3": "kit_clothing_mk3" } },
    "armor": { "name": "Armor", "kits": { "2": "kit_armor_mk2", "3": "kit_armor_mk3" } },
    "plating": { "name": "Linked plating", "kits": { "2": "kit_plating_mk2", "3": "kit_plating_mk3" } }
  },

  // Each mod is an item (kind Mod) with a slot, the gear types it fits and its effect. A crafted mod rolls a quality:
  // benefits scale with the tier's multiplier, drawbacks shrink by it (Fine: more good, less bad).
  // Weapon effects change the gear's attacks (ranged mods its ranged ones, melee mods its melee ones); worn-gear effects
  // change the piece itself.
  "mods": [
    { "id": "mod_iron_sight", "name": "Iron Sights", "slot": "sight", "types": ["firearm", "integrated"], "weight": 0.1, "tier": 1, "lootWeight": 0.35,
      "effect": { "accuracy": 0.04 } },
    { "id": "mod_reflex_sight", "name": "Reflex Sight", "slot": "sight", "types": ["firearm", "integrated"], "weight": 0.2, "tier": 2, "lootWeight": 0.2,
      "model": "mod_sight_reflex", "effect": { "accuracy": 0.08 } },
