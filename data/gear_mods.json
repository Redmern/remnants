      "model": "mod_compensator", "effect": { "accuracy": 0.03, "accuracyByAction": { "burst": 0.09 }, "noiseMultiplier": 1.15 } },
    { "id": "mod_long_barrel", "name": "Long Barrel", "slot": "muzzle", "types": ["firearm"], "weight": 1.2, "tier": 2, "lootWeight": 0.15,
      "model": "mod_long_barrel", "effect": { "reach": 2, "damageMultiplier": 1.12, "noiseMultiplier": 1.1 } },
    { "id": "mod_incendiary", "name": "Incendiary Rounds", "slot": "muzzle", "types": ["firearm", "integrated"], "weight": 0.3, "tier": 2, "lootWeight": 0.12,
      "effect": { "banes": [ { "tag": "husk", "hitBonus": 0.05, "damageMultiplier": 1.5 } ], "noiseMultiplier": 1.2, "reveal": 1 } },
    { "id": "mod_stock", "name": "Padded Stock", "slot": "stock", "types": ["firearm"], "weight": 0.6, "tier": 1, "lootWeight": 0.25,
