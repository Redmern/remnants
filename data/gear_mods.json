      "model": "mod_scope", "effect": { "accuracy": 0.1, "reach": 2, "closeRange": 2, "closeApPenalty": 1 } },
    { "id": "mod_suppressor", "name": "Suppressor", "slot": "muzzle", "types": ["firearm", "integrated"], "weight": 0.4, "tier": 2, "lootWeight": 0.15,
