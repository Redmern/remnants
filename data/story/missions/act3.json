  {"id": "m11", "act": 3, "name": "Lantern", "type": "Field", "main": true, "summary": "Iris's bunker is under the freight yard. Two Linked stand on her hatch. Get there unseen.", "teaches": "Full stealth play, relays, a hard hack.", "needsText": "M8; Town Hall 2; an Electronics Lab", "zone": "rail_depot", "threat": 3, "map": "handmade:m11_depot_sheds", "maxParty": 3, "requires": [{"mission": "m8"}, {"mission": "act3"}, {"townHall": 2}, {"building": "electronics_lab", "level": 1}], "briefing": "m11_brief", "debrief": "m11_debrief", "field": {"id": "m11", "name": "Lantern", "objectives": [{"id": "reach_hatch", "kind": "Reach", "text": "Get to the hatch", "marker": "hatch", "radius": 1}, {"id": "quiet", "kind": "Undetected", "text": "Stay unseen until the hatch"}, {"id": "hack_hatch", "kind": "Hack", "text": "Hack the hatch", "tag": "hatch", "hidden": true}, {"id": "node", "kind": "Hack", "text": "Break the relay node", "tag": "node", "hidden": true, "optional": true}, {"id": "log_1", "kind": "Hack", "text": "Read Iris's terminal 1", "tag": "log_1", "optional": true}, {"id": "log_2", "kind": "Hack", "text": "Read Iris's terminal 2", "tag": "log_2", "optional": true}, {"id": "log_3", "kind": "Hack", "text": "Read Iris's terminal 3", "tag": "log_3", "optional": true}, {"id": "log_4", "kind": "Hack", "text": "Read Iris's terminal 4", "tag": "log_4", "optional": true}, {"id": "log_5", "kind": "Hack", "text": "Read Iris's terminal 5", "tag": "log_5", "optional": true}, {"id": "meet", "kind": "Reach", "text": "Find Iris", "marker": "cot", "radius": 1, "hidden": true}, {"id": "chosen", "kind": "Reach", "text": "Bring Iris home, or leave her the radio", "marker": "cot", "radius": 99, "hidden": true}, {"id": "iris_out", "kind": "Escort", "text": "Get Iris out", "tag": "iris", "hidden": true, "optional": true}], "triggers": [{"id": "t1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "Two on the hatch, two walking. Cameras north