  {"id": "m12", "act": 3, "name": "Freight", "type": "Field", "main": true, "summary": "A Network train stops at the Depot to resupply the Relay. One car carries a freight diesel engine.", "teaches": "Carrying heavy objects, reinforcements.", "needsText": "M11 or day 75; Workshop L2 (Garage L2 with vehicles)", "zone": "rail_depot", "threat": 3, "map": "handmade:m12_east_yard", "maxParty": 4, "requires": [{"any": [{"mission": "m11"}, {"day": 75}]}, {"building": "workshop", "level": 2}], "briefing": "m12_brief", "debrief": "m12_debrief", "field": {"id": "m12", "name": "Freight", "objectives": [{"id": "door_a", "kind": "Hack", "text": "Open the engine car's outer door", "tag": "door_a"}, {"id": "doors", "kind": "Hack", "text": "Open the inner door", "tag": "door_b", "hidden": true}, {"id": "carry", "kind": "Carry", "text": "Pull the engine onto the cart (two survivors next to it)", "marker": "engine", "count": 3, "carriers": 2, "item": "diesel_engine", "hidden": true}, {"id": "hold", "kind": "Survive", "text": "Hold the yard", "count": 5, "hidden": true}, {"id": "engine", "kind": "Retrieve", "text": "Get the engine out", "item": "diesel_engine"}], "triggers": [{"id": "t1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "Network freight. Stops every four days to feed the Relay. Car three has what you want."}]}, {"id": "t_outer", "when": {"kind": "ObjectiveDone", "objective": "door_a"}, "actions": [{"kind": "Activate", "objective": "doors"}]}, {"id": "t_turret", "when": {"kind": "Sees", "tag": "turret"}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "Turret on the car door. Hack it and it's yours. Or go round. There's no round. Hack it."}]}, {"id": "t_in", "when": {"kind": "ObjectiveDone", "objective": "doors"}, "actions": [{"kind": "Activate", "objective": "carry"}, {"kind": "Say", "speaker": "player", "text": "It's huge. It's a whole engine. Get on either side of it."}]}, {"id": "t_pull", "when": {"kind": "ObjectiveDone", "objective": "carry"}, "actions": [{"kind": "Activate", "objective": "hold"}, {"kind": "Spawn", "enemy": "linked", "count": 2, "marker": "yard_n", "tag": "wave", "goal": "engine"}, {"kind": "Say", "speaker": "Lantern", "text": "Pylon just screamed. Five minutes, maybe less. Hold the yard."}]}, {"id": "t_w2", "when": {"kind": "After", "objective": "hold", "round": 2}, "actions": [{"kind": "Spawn", "enemy": "linked", "count": 1, "marker": "yard_s", "tag": "wave", "goal": "engine"}, {"kind": "Spawn", "enemy": "linked_drone", "count": 1, "marker": "yard_s", "tag": "wave", "goal": "engine"}]}, {"id": "t_w3", "when": {"kind": "After", "objective": "hold", "round": 4, "if": {"flag": "halcyon_offer", "min": 1, "max": 1}}, "actions": [{"kind": "Spawn", "enemy": "linked_warden", "count": 1, "marker": "yard_n", "tag": "wave", "goal": "engine"}, {"kind": "Say", "speaker": "Halcyon", "text": "I heard you coming. I always hear you coming now."}]}, {"id": "t_done", "when": {"kind": "ObjectiveDone", "objective": "hold"}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "Uplink's quiet. Take the engine and go. Don't take the train. You can't drive a train."}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_diesel_engine"}, {"kind": "Schematic", "id": "sch_truck"}, {"kind": "Schematic", "id": "sch_garage_3"}, {"kind": "Schematic", "id": "sch_linked_plating"}, {"kind": "Schematic", "id": "sch_armory_3"}, {"kind": "Fallback", "id": "", "text": "The engine waits in the Workshop for a Garage that can take it."}], "fail": {"retryDays": 4, "call": "m12_retry", "extraEnemies": [{"enemy": "linked", "marker": "platform", "count": 1}]}},
  {"id": "m13", "act": 3, "name": "Quiet Hours", "type": "Field", "main": true, "summary": "Take down the Relay's uplink and the valley goes dark to Halcyon. Fewer Linked in Ashgrove, for a while.", "teaches": "Relays, Override, jammers.", "needsText": "M11; a hacking kit or cyberdeck", "zone": "network_relay", "threat": 3, "map": "generated", "room": "m13_uplink", "maxParty": 4, "requires": [{"mission": "m11"}, {"any": [{"item": "hacking_kit"}, {"item": "cyberdeck"}]}], "briefing": "m13_brief", "debrief": "m13_debrief", "field": {"id": "m13", "name": "Quiet Hours", "fuseAfter": 3, "objectives": [{"id": "node_a", "kind": "Hack", "text": "Hack relay node A", "tag": "node_a", "failsMission": true}, {"id": "node_b", "kind": "Hack", "text": "Hack relay node B", "tag": "node_b", "failsMission": true}, {"id": "node_c", "kind": "Hack", "text": "Hack relay node C", "tag": "node_c", "failsMission": true}, {"id": "burn", "kind": "Survive", "text": "Hold while the uplink burns out", "count": 3, "hidden": true}, {"id": "uplink", "kind": "Hack", "text": "Read the uplink log", "tag": "log_uplink", "optional": true}], "triggers": [{"id": "t1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "Three nodes. Any order. Each one you take, a pylon goes dark. Then the uplink cooks itself."}]}, {"id": "t_a", "when": {"kind": "ObjectiveDone", "objective": "node_a"}, "actions": [{"kind": "Flag", "flag": "nodes", "value": 1, "add": true}, {"kind": "Say", "speaker": "Lantern", "text": "That's one."}]}, {"id": "t_b", "when": {"kind": "ObjectiveDone", "objective": "node_b"}, "actions": [{"kind": "Flag", "flag": "nodes", "value": 1, "add": true}, {"kind": "Say", "speaker": "Lantern", "text": "Another. Don't get comfortable."}]}, {"id": "t_c", "when": {"kind": "ObjectiveDone", "objective": "node_c"}, "actions": [{"kind": "Flag", "flag": "nodes", "value": 1, "add": true}, {"kind": "Say", "speaker": "Lantern", "text": "Node down."}]}, {"id": "t_all", "when": {"kind": "ObjectiveDone", "objective": "node_c", "if": {"flag": "nodes", "min": 3, "max": 3}}, "actions": [{"kind": "Activate", "objective": "burn"}, {"kind": "Flag", "flag": "nodes", "value": 10, "add": true}, {"kind": "Spawn", "enemy": "linked", "count": 2, "marker": "dish_door", "tag": "wave", "goal": "dish"}, {"kind": "Say", "speaker": "Lantern", "text": "Three. Here it comes —"}]}, {"id": "t_all_a", "when": {"kind": "ObjectiveDone", "objective": "node_a", "if": {"flag": "nodes", "min": 3, "max": 3}}, "actions": [{"kind": "Activate", "objective": "burn"}, {"kind": "Flag", "flag": "nodes", "value": 10, "add": true}, {"kind": "Spawn", "enemy": "linked", "count": 2, "marker": "dish_door", "tag": "wave", "goal": "dish"}, {"kind": "Say", "speaker": "Lantern", "text": "Three. Here it comes —"}]}, {"id": "t_all_b", "when": {"kind": "ObjectiveDone", "objective": "node_b", "if": {"flag": "nodes", "min": 3, "max": 3}}, "actions": [{"kind": "Activate", "objective": "burn"}, {"kind": "Flag", "flag": "nodes", "value": 10, "add": true}, {"kind": "Spawn", "enemy": "linked", "count": 2, "marker": "dish_door", "tag": "wave", "goal": "dish"}, {"kind": "Say", "speaker": "Lantern", "text": "Three. Here it comes —"}]}, {"id": "t_warden", "when": {"kind": "After", "objective": "burn", "round": 2}, "actions": [{"kind": "Spawn", "enemy": "linked_warden", "count": 1, "marker": "dish_door", "tag": "wave", "goal": "dish"}, {"kind": "Say", "speaker": "Lantern", "text": "Warden. Don't fight it. Outlast it."}]}, {"id": "t_truce", "when": {"kind": "Start", "if": {"flag": "halcyon_offer", "min": 1, "max": 1}}, "actions": [{"kind": "Spawn", "enemy": "linked", "count": 1, "marker": "hall", "tag": "heard"}]}, {"id": "t_alarm", "when": {"kind": "Alarm"}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "Fail on a Network node and the Network notices. It's noticed."}]}, {"id": "t_log", "when": {"kind": "ObjectiveDone", "objective": "uplink"}, "actions": [{"kind": "Flag", "flag": "log_uplink", "value": 1}]}, {"id": "t_burned", "when": {"kind": "ObjectiveDone", "objective": "burn"}, "actions": [{"kind": "Say", "speaker": "narration", "text": "(The dish groans, sparks, and sags. Across the valley, channel nine goes quiet.)"}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_signal_jammer"}, {"kind": "Schematic", "id": "sch_override"}, {"kind": "Schematic", "id": "sch_armor_plates"}, {"kind": "WorldEffect", "id": "relay_down", "value": 30}, {"kind": "Call", "id": "m14_warning", "value": 72}], "fail": {"retryDays": 5, "call": "m13_retry"}},
  {"id": "m14", "act": 3, "name": "Halcyon Speaks", "type": "Field", "main": true, "summary": "The radio switches itself on. Halcyon talks to the colony. Then the Linked come, not to kill: to Link.", "teaches": "The Linked as an enemy with a goal; what the stakes are.", "needsText": "M13, three days later at dusk", "zone": "outskirts", "threat": 3, "map": "handmade:perimeter_linked", "maxParty": 4, "requires": [{"mission": "m13"}, {"flag": "m14_ready"}], "briefing": "m14_open", "debrief": "m14_debrief", "field": {"id": "m14", "name": "Halcyon Speaks", "atHome": true, "takeTag": "link", "takeRounds": 2, "objectives": [{"id": "night", "kind": "Survive", "text": "Survive the night (8 rounds)", "count": 8}, {"id": "half", "kind": "Keep", "text": "Don't let them take half of you", "count": 50, "failsMission": true}, {"id": "mast", "kind": "Defend", "text": "Keep the Radio Mast standing", "tag": "mast", "optional": true}], "triggers": [{"id": "t_start", "when": {"kind": "Start"}, "actions": [{"kind": "Say", "speaker": "Halcyon", "text": "Please keep the children inside."}]}, {"id": "t_w1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Spawn", "enemy": "linked", "count": 3, "marker": "tree_w", "tag": "link", "goal": "yard"}]}, {"id": "t_w2", "when": {"kind": "Round", "round": 3}, "actions": [{"kind": "Spawn", "enemy": "linked", "count": 2, "marker": "tree_n", "tag": "link", "goal": "yard"}, {"kind": "Spawn", "enemy": "linked_drone", "count": 2, "marker": "tree_n", "tag": "link", "goal": "yard"}]}, {"id": "t_w3", "when": {"kind": "Round", "round": 6}, "actions": [{"kind": "Spawn", "enemy": "linked", "count": 2, "marker": "tree_e", "tag": "link", "goal": "yard"}, {"kind": "Spawn", "enemy": "linked_warden", "count": 1, "marker": "tree_e", "tag": "link", "goal": "yard"}]}, {"id": "t_r2", "when": {"kind": "Round", "round": 2}, "actions": [{"kind": "Say", "speaker": "Halcyon", "text": "Lie down if you are hurt. They will be gentle. I promise they will be gentle."}]}, {"id": "t_r5", "when": {"kind": "Round", "round": 5}, "actions": [{"kind": "Say", "speaker": "player", "text": "They're not shooting to kill. They're — they're picking people up."}]}, {"id": "t_taken", "when": {"kind": "Taken"}, "actions": [{"kind": "Say", "speaker": "Halcyon", "text": "Thank you. I will look after them."}]}, {"id": "t_r8", "when": {"kind": "Round", "round": 8}, "actions": [{"kind": "Say", "speaker": "Halcyon", "text": "Enough. I am not here to hurt you. I will see you soon."}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_linked_carbine"}, {"kind": "Schematic", "id": "sch_lab_3"}], "fail": {"effects": []}},
