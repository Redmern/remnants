[
  {"id": "side_marrows_debt", "act": 2, "name": "Marrow's Debt", "type": "Field", "main": false, "summary": "Marrow owes the Tally. Get his ledger back before Cole reads it.", "teaches": "Stealth around a neutral band.", "needsText": "M6; Marrow alive", "zone": "scrapyard_flats", "threat": 2, "map": "generated", "room": "side_tally_camp", "maxParty": 3, "requires": [{"mission": "m6"}, {"alive": "marrow"}], "briefing": "sd_debt_brief", "debrief": "sd_debt_done", "field": {"id": "side_marrows_debt", "name": "Marrow's Debt", "objectives": [{"id": "ledger", "kind": "Retrieve", "text": "Bring back Marrow's ledger", "item": "marrow_ledger"}, {"id": "quiet", "kind": "Undetected", "text": "Don't let the Tally see you", "optional": true}], "triggers": [{"id": "t1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Say", "speaker": "Marrow", "text": "Red book. Tin box. Cole's fire. Don't read it."}]}, {"id": "t_got", "when": {"kind": "PickedUp", "item": "marrow_ledger"}, "actions": [{"kind": "Say", "speaker": "Marrow", "text": "Got it? Don't read it. ...You read it. Everybody reads it."}]}, {"id": "t_seen", "when": {"kind": "ObjectiveFailed", "objective": "quiet"}, "actions": [{"kind": "SetSide", "tag": "tally", "side": "hostile"}, {"kind": "SetSide", "tag": "cole", "side": "hostile"}, {"kind": "Flag", "flag": "cole_respect", "value": -1, "add": true}, {"kind": "Say", "speaker": "Tally", "text": "That's Marrow's book! Cole wants that book!"}]}, {"id": "t_cole", "when": {"kind": "Hurt", "tag": "cole", "below": 0.5}, "actions": [{"kind": "Leave", "tag": "cole"}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_radio_mast_2"}, {"kind": "Schematic", "id": "sch_muffler"}, {"kind": "Item", "id": "fuel_can", "value": 4}, {"kind": "Item", "id": "marrow_ledger", "value": -1}], "fail": {"retryDays": 3}},
  {"id": "side_docs_rounds", "act": 2, "name": "Doc's Rounds", "type": "Field", "main": false, "summary": "A patient is on the radio. Bring them in alive.", "teaches": "Rescue.", "needsText": "M7", "zone": "suburb_ruins", "threat": 2, "map": "generated", "room": "side_hideout", "maxParty": 3, "requires": [{"mission": "m7"}], "briefing": "sd_rounds_call", "debrief": "sd_rounds_done", "field": {"id": "side_docs_rounds", "name": "Doc's Rounds", "objectives": [{"id": "find", "kind": "Reach", "text": "Find the patient", "marker": "patient", "radius": 1}, {"id": "treat", "kind": "Aid", "text": "Treat them (bandage or med-kit)", "tag": "patient"}, {"id": "bring", "kind": "Escort", "text": "Bring them home", "tag": "patient", "failsMission": true}], "triggers": [{"id": "t_treat", "when": {"kind": "ObjectiveDone", "objective": "treat"}, "actions": [{"kind": "Follow", "tag": "patient"}, {"kind": "Say", "speaker": "Doc", "text": "Good. Now walk them. Slowly. Faster than that."}]}]}, "rewards": [{"kind": "Resource", "id": "medicine", "value": 3}, {"kind": "ResearchData", "id": "", "value": 2}, {"kind": "AddFlag", "id": "rounds_done", "value": 1}], "fail": {"retryDays": 10, "effects": [{"kind": "AddFlag", "id": "rounds_lost", "value": 1}, {"kind": "Mood", "id": "hale", "value": -10}]}, "repeatDays": 14},
  {"id": "side_sevens_name", "act": 3, "name": "Seven's Name", "type": "Field", "main": false, "summary": "Seven knows where the kitchen is. It wants to go and look.", "teaches": "Stealth with someone who must not be seen.", "needsText": "Seven in the colony; Act 3", "zone": "suburb_ruins", "threat": 2, "map": "generated", "room": "side_yellow_kitchen", "maxParty": 3, "requires": [{"joined": "seven"}, {"mission": "act3"}], "briefing": "sd_seven_brief", "debrief": "sd_seven_name", "field": {"id": "side_sevens_name", "name": "Seven's Name", "objectives": [{"id": "quiet", "kind": "Undetected", "text": "Get there unseen", "failsMission": true}, {"id": "kitchen", "kind": "Reach", "text": "Seven reaches the kitchen", "marker": "kitchen", "radius": 1, "by": "seven"}, {"id": "look", "kind": "Reach", "text": "Look out of the window", "marker": "window", "radius": 1}], "triggers": [{"id": "t1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Say", "speaker": "Seven", "text": "Left at the burned car. Then the tree that looks like a hand. My feet know this."}]}, {"id": "t_still", "when": {"kind": "Sees", "tag": "still"}, "actions": [{"kind": "Say", "speaker": "Seven", "text": "There is someone at the table. Do not wake them. They are having dinner."}]}, {"id": "t_kitchen", "when": {"kind": "Enter", "marker": "kitchen", "radius": 2}, "actions": [{"kind": "Prompt", "prompt": {"id": "sd_kitchen", "speaker": "Seven", "text": "This is it. I know the tiles. Someone measured two children on the door frame. Was I one of them? Was I the one measuring? Or the thing that came in the door, after?", "options": [{"id": "person", "text": "You were someone who lived here."}, {"id": "copy", "text": "Maybe you're a copy. That's still someone."}, {"id": "halcyon", "text": "Maybe you're part of it. Of Halcyon."}]}}]}, {"id": "t_p", "when": {"kind": "Chosen", "choice": "sd_kitchen:person"}, "actions": [{"kind": "Flag", "flag": "seven_hint", "value": 1}, {"kind": "Say", "speaker": "Seven", "text": "Then I was loved. That is a good thing to have been."}]}, {"id": "t_c", "when": {"kind": "Chosen", "choice": "sd_kitchen:copy"}, "actions": [{"kind": "Flag", "flag": "seven_hint", "value": 2}, {"kind": "Say", "speaker": "Seven", "text": "A copy of a person is a kind of person. I can live with kind of."}]}, {"id": "t_h", "when": {"kind": "Chosen", "choice": "sd_kitchen:halcyon"}, "actions": [{"kind": "Flag", "flag": "seven_hint", "value": 3}, {"kind": "Say", "speaker": "Seven", "text": "Then a piece of it came here and remembered a kitchen. That might be hope."}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_spec_hacker"}, {"kind": "Schematic", "id": "sch_spec_silent"}], "fail": {"retryDays": 5}, "mustBring": ["seven"]},
  {"id": "side_cole_ally", "act": 3, "name": "Cole's Last Job", "type": "Field", "main": false, "summary": "The Linked found the Tally's camp. Cole calls in what you owe him: walk his people out.", "teaches": "Escort under fire.", "needsText": "M9; Cole an ally", "zone": "scrapyard_flats", "threat": 2, "map": "generated", "room": "side_tally_camp", "maxParty": 4, "gearTier": 2, "requires": [{"mission": "m9"}, {"mission": "act3"}, {"flag": "cole_path", "min": 1, "max": 1}], "briefing": "sd_cole_ally_brief", "debrief": "sd_cole_ally_done", "field": {"id": "side_cole_ally", "name": "Cole's Last Job", "objectives": [{"id": "family", "kind": "Escort", "text": "Walk the Tally's families out", "tag": "family"}, {"id": "cole", "kind": "Defend", "text": "Keep Cole alive", "tag": "cole", "failsMission": true}], "triggers": [{"id": "t_start", "when": {"kind": "Start"}, "actions": [{"kind": "SetSide", "tag": "tally", "side": "party"}, {"kind": "SetSide", "tag": "cole", "side": "party"}, {"kind": "Follow", "tag": "family"}, {"kind": "Say", "speaker": "Cole Brannigan", "text": "Nineteen names on the list. I'd like nineteen at the end."}]}, {"id": "t_w1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Spawn", "enemy": "linked", "count": 3, "marker": "north", "tag": "link", "goal": "cole"}]}, {"id": "t_w2", "when": {"kind": "Round", "round": 3}, "actions": [{"kind": "Spawn", "enemy": "linked_drone", "count": 2, "marker": "north", "tag": "link", "goal": "family"}, {"kind": "Say", "speaker": "Cole Brannigan", "text": "Drones! Heads down, kids first, count off!"}]}, {"id": "t_w3", "when": {"kind": "Round", "round": 5}, "actions": [{"kind": "Spawn", "enemy": "linked_warden", "count": 1, "marker": "north", "tag": "link", "goal": "cole"}, {"kind": "Say", "speaker": "Cole Brannigan", "text": "Warden. I'll hold it. — No? You'll hold it? ...I'm writing that down."}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_spec_gun"}, {"kind": "Character", "id": "cole", "value": 2}, {"kind": "Recruit", "id": "", "text": "Ruth Okafor"}, {"kind": "Recruit", "id": "", "text": "Ames"}, {"kind": "Recruit", "id": "", "text": "Little Tom"}, {"kind": "SetFlag", "id": "cole_alive", "value": 1}], "fail": {"effects": [{"kind": "Dies", "id": "cole", "text": "Died walking his people out"}, {"kind": "SetFlag", "id": "cole_alive", "value": 0}]}},
  {"id": "side_tally_raid", "act": 3, "name": "The Tally Comes", "type": "Field", "main": false, "summary": "Cole's band comes for the colony's food.", "teaches": "Defending against people.", "needsText": "Cole an enemy", "zone": "outskirts", "threat": 3, "map": "perimeter", "maxParty": 4, "gearTier": 3, "requires": [{"flag": "cole_path", "min": 2, "max": 2}, {"mission": "m11"}], "briefing": "sd_raid_brief", "debrief": "sd_raid_done", "field": {"id": "side_tally_raid", "name": "The Tally Comes", "atHome": true, "objectives": [{"id": "hold", "kind": "Survive", "text": "Hold them off (6 rounds)", "count": 6}, {"id": "mast", "kind": "Defend", "text": "Keep the Radio Mast standing", "tag": "mast", "optional": true}], "triggers": [{"id": "t1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Spawn", "enemy": "tally_scav", "count": 4, "marker": "treeline", "tag": "tally", "goal": "mast"}, {"kind": "Spawn", "enemy": "cole", "count": 1, "marker": "treeline", "tag": "cole", "goal": "mast"}, {"kind": "Say", "speaker": "Cole Brannigan", "text": "Food, fuel, medicine. In that order. I heard that's how you count."}]}, {"id": "t_cole", "when": {"kind": "Hurt", "tag": "cole", "below": 0.5}, "actions": [{"kind": "Say", "speaker": "Cole Brannigan", "text": "That's one you owe me."}, {"kind": "Leave", "tag": "cole"}]}]}, "rewards": [{"kind": "Note", "id": "", "text": "The Tally fell back to the Flats."}], "fail": {"effects": [{"kind": "Resource", "id": "food", "value": -30}, {"kind": "Note", "id": "", "text": "The Tally took food on their way out."}]}},
  {"id": "side_cole_enemy", "act": 3, "name": "Cole's Last Job", "type": "Field", "main": false, "summary": "Cole comes for you himself.", "teaches": "A last stand.", "needsText": "Cole an enemy; after the raid", "zone": "outskirts", "threat": 3, "map": "perimeter", "maxParty": 4, "gearTier": 3, "requires": [{"flag": "cole_path", "min": 2, "max": 2}, {"mission": "side_tally_raid"}], "briefing": "sd_cole_enemy_brief", "debrief": "sd_cole_enemy_done", "field": {"id": "side_cole_enemy", "name": "Cole's Last Job", "atHome": true, "objectives": [{"id": "hold", "kind": "Survive", "text": "Hold the colony (10 rounds)", "count": 10}, {"id": "cole", "kind": "KillTag", "text": "Bring down Cole", "tag": "cole", "count": 1, "optional": true}, {"id": "mast", "kind": "Defend", "text": "Keep the Radio Mast standing", "tag": "mast", "optional": true}], "triggers": [{"id": "t1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Spawn", "enemy": "cole", "count": 1, "marker": "treeline", "tag": "cole", "goal": "mast"}, {"kind": "Spawn", "enemy": "tally_scav", "count": 3, "marker": "treeline", "tag": "tally", "goal": "mast"}, {"kind": "Spawn", "enemy": "tally_blade", "count": 1, "marker": "treeline", "tag": "tally", "goal": "mast"}, {"kind": "Say", "speaker": "Cole Brannigan", "text": "I had nineteen names. Now I have twelve. Tell me again whose fault that is."}]}, {"id": "t4", "when": {"kind": "Round", "round": 4}, "actions": [{"kind": "Spawn", "enemy": "tally_scav", "count": 3, "marker": "treeline", "tag": "tally", "goal": "mast"}, {"kind": "Spawn", "enemy": "tally_blade", "count": 1, "marker": "treeline", "tag": "tally", "goal": "mast"}, {"kind": "Say", "speaker": "Cole Brannigan", "text": "Second wave. I always bring a second wave. I wrote that down too."}]}, {"id": "t_down", "when": {"kind": "ObjectiveDone", "objective": "cole"}, "actions": [{"kind": "Complete", "objective": "hold"}, {"kind": "Say", "speaker": "narration", "text": "(Cole goes down by the gate. His notebook falls open. Your colony's name is on every page.)"}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_spec_blade", "when": {"flag": "side_cole_enemy_cole"}}, {"kind": "Item", "id": "cole_ledger", "value": 1, "when": {"flag": "side_cole_enemy_cole"}}, {"kind": "Dies", "id": "cole", "text": "Fell at your gate", "when": {"flag": "side_cole_enemy_cole"}}, {"kind": "SetFlag", "id": "cole_alive", "value": 1, "when": {"not": {"flag": "side_cole_enemy_cole"}}}], "fail": {"retryDays": 5}},
  {"id": "side_children", "act": 4, "name": "Children of the Choir", "type": "Field", "main": false, "summary": "Linked children are kept at the Relay. Getting them out is the most human thing in the game.", "teaches": "Rescue.", "needsText": "M14; Pell grown; a colony still mostly itself", "zone": "network_relay", "threat": 3, "map": "generated", "room": "side_choir_nursery", "maxParty": 4, "requires": [{"mission": "m14"}, {"adult": "pell"}, {"humanityMin": 50}], "briefing": "sd_choir_brief", "debrief": "sd_choir_done", "field": {"id": "side_children", "name": "Children of the Choir", "objectives": [{"id": "find", "kind": "Reach", "text": "Find the children", "marker": "child_1", "radius": 1}, {"id": "out_1", "kind": "Escort", "text": "Bring the first child home", "tag": "child_1"}, {"id": "out_2", "kind": "Escort", "text": "Bring the second child home", "tag": "child_2", "optional": true}, {"id": "out_3", "kind": "Escort", "text": "Bring the third child home", "tag": "child_3", "optional": true}, {"id": "quiet", "kind": "Undetected", "text": "No fighting near the children", "optional": true}], "triggers": [{"id": "t1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Say", "speaker": "Pell", "text": "I can hear them. They're singing the song. The one from channel nine. I know all the words."}]}, {"id": "t_c1", "when": {"kind": "Enter", "marker": "child_1", "radius": 1}, "actions": [{"kind": "Follow", "tag": "child_1"}, {"kind": "Say", "speaker": "narration", "text": "(The child blinks. Looks at their hands. Starts to cry, the way children cry when they've just woken up somewhere wrong.)"}]}, {"id": "t_c2", "when": {"kind": "Enter", "marker": "child_2", "radius": 1}, "actions": [{"kind": "Follow", "tag": "child_2"}]}, {"id": "t_c3", "when": {"kind": "Enter", "marker": "child_3", "radius": 1}, "actions": [{"kind": "Follow", "tag": "child_3"}]}, {"id": "t_alarm", "when": {"kind": "Alarm"}, "actions": [{"kind": "Wake", "tag": "minder", "goal": "child_1"}]}]}, "rewards": [{"kind": "Recruit", "id": "child", "value": 60, "text": "Mira", "when": {"flag": "side_children_out_1"}}, {"kind": "AddFlag", "id": "children_freed", "value": 1, "when": {"flag": "side_children_out_1"}}, {"kind": "Recruit", "id": "child", "value": 60, "text": "Oskar", "when": {"flag": "side_children_out_2"}}, {"kind": "AddFlag", "id": "children_freed", "value": 1, "when": {"flag": "side_children_out_2"}}, {"kind": "Recruit", "id": "child", "value": 60, "text": "Lune", "when": {"flag": "side_children_out_3"}}, {"kind": "AddFlag", "id": "children_freed", "value": 1, "when": {"flag": "side_children_out_3"}}], "fail": {"retryDays": 5}},
  {"id": "side_dead_drop", "act": 2, "name": "Dead Drop", "type": "Field", "main": false, "summary": "A pickup for the caravan. Box in a shed. Don't open it.", "teaches": "Contracts.", "needsText": "The caravan is open, Town Hall 2", "zone": "scrapyard_flats", "threat": 1, "map": "generated", "room": "side_dead_drop", "maxParty": 3, "requires": [{"mission": "m4"}, {"townHall": 2}], "briefing": "sd_drop_call", "debrief": "sd_drop_done", "field": {"id": "side_dead_drop", "name": "Dead Drop", "objectives": [{"id": "crate", "kind": "Retrieve", "text": "Bring the crate home", "item": "trade_crate"}], "triggers": [{"id": "t1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Say", "speaker": "Radio", "text": "Box in a shed. In and out."}]}]}, "rewards": [{"kind": "Resource", "id": "scrap", "value": 15}, {"kind": "Resource", "id": "electronics", "value": 4}, {"kind": "Item", "id": "trade_crate", "value": -1}], "fail": {"retryDays": 7}, "repeatDays": 10}
]
