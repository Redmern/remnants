[
  {"id": "m6", "act": 2, "name": "The Long Haul", "type": "Field", "main": true, "summary": "Marrow is moving cargo and fuel through the Ruins and asks the colony to ride shotgun.", "teaches": "World-map travel, fuel, escorting moving units.", "needsText": "M4; Marrow has visited twice", "zone": "scrapyard_flats", "threat": 2, "map": "handmade:m6_freight_road", "maxParty": 4, "requires": [{"mission": "m4"}, {"flag": "marrow_visits", "min": 2}], "briefing": "m6_open", "debrief": "m6_close", "field": {"id": "m6", "name": "The Long Haul", "objectives": [{"id": "o_people", "kind": "Escort", "text": "Keep the people's truck moving", "tag": "truck_people", "optional": true}, {"id": "o_cargo", "kind": "Escort", "text": "Keep the cargo truck moving", "tag": "truck_cargo", "optional": true}, {"id": "o_marrow", "kind": "Escort", "text": "Keep Marrow alive", "tag": "marrow", "optional": true}, {"id": "o_ambush", "kind": "KillTag", "text": "Break the ambush", "tag": "ambush", "count": 3, "hidden": true, "optional": true}, {"id": "o_out", "kind": "Reach", "text": "Get the convoy to the far edge", "marker": "ambush_s", "radius": 40, "hidden": true}], "triggers": [{"id": "t_start", "when": {"kind": "Start"}, "actions": [{"kind": "SetSide", "tag": "truck_people", "side": "party"}, {"kind": "SetSide", "tag": "truck_cargo", "side": "party"}, {"kind": "SetSide", "tag": "marrow", "side": "party"}, {"kind": "Follow", "tag": "truck_people"}, {"kind": "Follow", "tag": "truck_cargo"}, {"kind": "Follow", "tag": "marrow"}, {"kind": "Say", "speaker": "Marrow", "text": "Stay off the hoods. Stay near the wheels."}]}, {"id": "t_r2", "when": {"kind": "Round", "round": 2}, "actions": [{"kind": "Say", "speaker": "Marrow", "text": "Freight road. Used to be eight lanes. Now it's two and a half."}]}, {"id": "t_r4", "when": {"kind": "Round", "round": 4}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "I've got Network chatter on your road. Could be nothing. It's never nothing."}]}, {"id": "t_ambush", "when": {"kind": "Round", "round": 6}, "actions": [{"kind": "Spawn", "enemy": "linked", "count": 1, "marker": "ambush_n", "tag": "ambush", "goal": "truck_cargo"}, {"kind": "Spawn", "enemy": "linked_drone", "count": 2, "marker": "ambush_s", "tag": "ambush", "goal": "truck_people"}, {"kind": "Activate", "objective": "o_ambush"}, {"kind": "Prompt", "prompt": {"id": "m6_split", "speaker": "Dee", "text": "Drones on the people truck. Something big on mine. We're splitting — we have to!", "options": [{"id": "people", "text": "Cover the people.", "hint": "The cargo truck is on its own."}, {"id": "cargo", "text": "Cover the cargo.", "hint": "Marrow's truck is on its own."}, {"id": "both", "text": "We split too.", "hint": "Thin, but nobody's alone."}]}}]}, {"id": "t_people", "when": {"kind": "Chosen", "choice": "m6_split:people"}, "actions": [{"kind": "Say", "speaker": "Marrow", "text": "Good call. Cargo's insured. By nobody. Go."}, {"kind": "Activate", "objective": "o_out"}]}, {"id": "t_cargo", "when": {"kind": "Chosen", "choice": "m6_split:cargo"}, "actions": [{"kind": "Say", "speaker": "Marrow", "text": "Fuel's worth more than me today. Fine. Fine!"}, {"kind": "Activate", "objective": "o_out"}]}, {"id": "t_both", "when": {"kind": "Chosen", "choice": "m6_split:both"}, "actions": [{"kind": "Say", "speaker": "Marrow", "text": "Ha! Greedy. I like greedy. Don't die of it."}, {"kind": "Activate", "objective": "o_out"}]}, {"id": "t_marrow_down", "when": {"kind": "ObjectiveFailed", "objective": "o_marrow"}, "actions": [{"kind": "Say", "speaker": "Dee", "text": "Abel's down. Abel's — keep driving. KEEP DRIVING."}, {"kind": "Flag", "flag": "marrow_dead", "value": 1}]}, {"id": "t_cleared", "when": {"kind": "ObjectiveDone", "objective": "o_ambush"}, "actions": [{"kind": "Say", "speaker": "Marrow", "text": "Count the people. Then count the cargo. In that order. Always that order."}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_motorbike"}, {"kind": "Schematic", "id": "sch_small_engine"}, {"kind": "Schematic", "id": "sch_garage_2"}, {"kind": "Schematic", "id": "sch_biofuel_still"}, {"kind": "Schematic", "id": "sch_rifle"}, {"kind": "Fallback", "id": "", "text": "Marrow's notes wait in the Workshop until the colony has a Garage."}, {"kind": "Resource", "id": "scrap", "value": 10}, {"kind": "AddFlag", "id": "m6_saved", "value": 1, "when": {"flag": "m6_o_people"}}, {"kind": "AddFlag", "id": "m6_saved", "value": 2, "when": {"flag": "m6_o_cargo"}}, {"kind": "SetFlag", "id": "m6_saved", "value": 2, "when": {"not": {"any": [{"flag": "m6_o_people"}, {"flag": "m6_o_cargo"}]}}}, {"kind": "SetFlag", "id": "convoy_ready", "value": 1, "when": {"flag": "m6_o_people"}}, {"kind": "SetFlag", "id": "marrow_price_mod", "value": -10, "when": {"flag": "m6_o_people"}}, {"kind": "Item", "id": "linked_carbine", "value": 3, "when": {"flag": "m6_o_cargo"}}, {"kind": "Resource", "id": "electronics", "value": 6, "when": {"flag": "m6_o_cargo"}}, {"kind": "Dies", "id": "marrow", "text": "Died in his cab on the Ruins road", "when": {"flag": "marrow_dead"}}], "fail": {"retryDays": 4, "call": "m6_retry", "extraEnemies": [{"enemy": "husk", "marker": "verge", "count": 2}]}},
  {"id": "m7", "act": 2, "name": "The Drowned Clinic", "type": "Field", "main": true, "summary": "Doc Hale is mid-surgery in the Mall pharmacy. The water is coming in. So are the Husks.", "teaches": "Survive N rounds, water, prosthetics.", "needsText": "M4; a Med Bay", "zone": "flooded_mall", "threat": 2, "map": "handmade:m7_drowned_pharmacy", "maxParty": 4, "requires": [{"mission": "m4"}, {"building": "med_bay", "level": 1}], "briefing": "m7_open", "debrief": "m7_close", "field": {"id": "m7", "name": "The Drowned Clinic", "objectives": [{"id": "o_reach", "kind": "Reach", "text": "Reach the clinic", "marker": "clinic", "radius": 2}, {"id": "o_hold", "kind": "Survive", "text": "Hold the clinic while Doc operates", "count": 6, "hidden": true}, {"id": "o_doc", "kind": "Escort", "text": "Get Doc out", "tag": "doc", "hidden": true}, {"id": "o_patient", "kind": "Escort", "text": "Get her patient out", "tag": "patient", "hidden": true, "optional": true}, {"id": "o_doc_alive", "kind": "Defend", "text": "Keep Doc alive", "tag": "doc", "failsMission": true}], "triggers": [{"id": "t_r1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "Mall's half underwater. Water slows you. It slows them too. Mostly."}]}, {"id": "t_door", "when": {"kind": "Enter", "marker": "clinic_door", "radius": 1}, "actions": [{"kind": "Say", "speaker": "Doc", "text": "Shut the door. No — leave it. I need the light. Shut the OTHER door."}]}, {"id": "t_reach", "when": {"kind": "ObjectiveDone", "objective": "o_reach"}, "actions": [{"kind": "Prompt", "prompt": {"id": "m7_clinic", "speaker": "Doc", "text": "You're late. Everyone's late. Hold that lamp. Six minutes. Hold the door for six minutes.", "options": [{"id": "hold", "text": "Six minutes. Go."}, {"id": "help", "text": "Tell me what to do."}, {"id": "why", "text": "Is he worth it?", "hint": "Doc will remember this."}]}}]}, {"id": "t_hold_a", "when": {"kind": "Chosen", "choice": "m7_clinic:hold"}, "actions": [{"kind": "Activate", "objective": "o_hold"}, {"kind": "Spawn", "enemy": "husk", "count": 3, "marker": "wave_w", "tag": "wave", "goal": "doc"}]}, {"id": "t_hold_b", "when": {"kind": "Chosen", "choice": "m7_clinic:help"}, "actions": [{"kind": "Activate", "objective": "o_hold"}, {"kind": "Flag", "flag": "helped_doc", "value": 1}, {"kind": "Say", "speaker": "Doc", "text": "Hold still. You'll scream either way, but if you hold still you'll keep the leg. ...That was for him."}, {"kind": "Spawn", "enemy": "husk", "count": 3, "marker": "wave_w", "tag": "wave", "goal": "doc"}]}, {"id": "t_hold_c", "when": {"kind": "Chosen", "choice": "m7_clinic:why"}, "actions": [{"kind": "Activate", "objective": "o_hold"}, {"kind": "Flag", "flag": "doc_cold", "value": 1}, {"kind": "Say", "speaker": "Doc", "text": "Ask me that again and you can hold the saw."}, {"kind": "Spawn", "enemy": "husk", "count": 3, "marker": "wave_w", "tag": "wave", "goal": "doc"}]}, {"id": "t_wave2", "when": {"kind": "After", "objective": "o_hold", "round": 3}, "actions": [{"kind": "Spawn", "enemy": "husk", "count": 2, "marker": "wave_n", "tag": "wave", "goal": "doc"}, {"kind": "Spawn", "enemy": "husk_crawler", "count": 1, "marker": "wave_n", "tag": "wave", "goal": "doc"}, {"kind": "Say", "speaker": "Doc", "text": "Halfway. Don't look. I said don't look."}]}, {"id": "t_wave3", "when": {"kind": "After", "objective": "o_hold", "round": 5}, "actions": [{"kind": "Spawn", "enemy": "husk", "count": 3, "marker": "wave_w", "tag": "wave", "goal": "doc"}, {"kind": "Spawn", "enemy": "husk", "count": 3, "marker": "wave_n", "tag": "wave", "goal": "doc"}, {"kind": "Say", "speaker": "Doc", "text": "Closing. Somebody find me a clean towel. Clean-ish."}]}, {"id": "t_done", "when": {"kind": "ObjectiveDone", "objective": "o_hold"}, "actions": [{"kind": "Activate", "objective": "o_doc"}, {"kind": "Activate", "objective": "o_patient"}, {"kind": "Follow", "tag": "doc"}, {"kind": "Follow", "tag": "patient"}, {"kind": "Say", "speaker": "Doc", "text": "Done. He'll live if you carry him. Carry him."}]}, {"id": "t_doc_dead", "when": {"kind": "ObjectiveFailed", "objective": "o_doc_alive"}, "actions": [{"kind": "Flag", "flag": "doc_died", "value": 1}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_mech_limbs"}, {"kind": "Schematic", "id": "sch_powered_limbs"}, {"kind": "Resource", "id": "medicine", "value": 6}, {"kind": "Character", "id": "hale", "value": 2}, {"kind": "SetFlag", "id": "doc_state", "value": 1}, {"kind": "Call", "id": "m7_home", "value": 6}], "fail": {"retryDays": 3, "call": "m7_retry", "effects": [{"kind": "Schematic", "id": "sch_mech_limbs", "when": {"flag": "doc_died"}}, {"kind": "Schematic", "id": "sch_powered_limbs", "when": {"flag": "doc_died"}}, {"kind": "Resource", "id": "medicine", "value": 6, "when": {"flag": "doc_died"}}, {"kind": "SetFlag", "id": "doc_state", "value": 2, "when": {"flag": "doc_died"}}, {"kind": "Dies", "id": "hale", "text": "Died at her clinic in the Flooded Mall", "when": {"flag": "doc_died"}}, {"kind": "Call", "id": "m7_lost", "when": {"flag": "doc_died"}}, {"kind": "Close", "id": "m7", "text": "failed", "when": {"flag": "doc_died"}}]}},
  {"id": "m8", "act": 2, "name": "Eyes Up", "type": "Field", "main": true, "summary": "Iris wants eyes on the Rail Depot. A scout drone went down in the Mall's atrium, under the Linked drone's circuit.", "teaches": "Cameras, scout drones, the Decrypt queue.", "needsText": "M7 or day 45; an Electronics Lab", "zone": "flooded_mall", "threat": 2, "map": "generated", "room": "m8_atrium", "maxParty": 4, "requires": [{"any": [{"mission": "m7"}, {"day": 45}]}, {"building": "electronics_lab", "level": 1}], "briefing": "m8_open", "debrief": "m8_flight", "field": {"id": "m8", "name": "Eyes Up", "objectives": [{"id": "o_core", "kind": "Retrieve", "text": "Bring the drone core home", "item": "drone_core"}, {"id": "o_camera", "kind": "Hack", "text": "Hack the atrium camera", "tag": "cam", "optional": true}], "triggers": [{"id": "t_r1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "Atrium's under a drone circuit. Four corners, round and round. Count it."}]}, {"id": "t_cam", "when": {"kind": "Sees", "tag": "cam"}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "Camera. Don't hack the camera. Hack the thing the camera reports to. ...Kidding, there's nothing up there. Hack the camera."}]}, {"id": "t_core", "when": {"kind": "PickedUp", "item": "drone_core"}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "That's it. That's my baby. Don't drop her. She's very old and very rude."}]}, {"id": "t_alarm", "when": {"kind": "Alarm"}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "That was loud. Drone's going to come look. Be somewhere else."}, {"kind": "Wake", "tag": "circuit", "goal": "core"}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_scout_drone"}, {"kind": "Schematic", "id": "sch_scanner"}, {"kind": "Item", "id": "scout_drone", "value": 1}, {"kind": "Item", "id": "drone_core", "value": -1}], "fail": {"retryDays": 3, "call": "m8_retry"}},
  {"id": "m9", "act": 2, "name": "The Tally", "type": "Field", "main": true, "summary": "A sealed pre-war armoury has opened. The Tally got there first. Cole is waiting at the door.", "teaches": "Alliances, stealth-only routes, choices that stick.", "needsText": "M3, M6", "zone": "suburb_ruins", "threat": 2, "map": "generated", "room": "m9_armoury", "maxParty": 4, "requires": [{"mission": "m3"}, {"mission": "m6"}], "briefing": "m9_open", "debrief": "m9_close", "field": {"id": "m9", "name": "The Tally", "objectives": [{"id": "o_vault", "kind": "Reach", "text": "Get into the vault", "marker": "vault", "radius": 1}, {"id": "o_husks", "kind": "KillTag", "text": "Clear the bunker's Husks", "tag": "vault_husk", "count": 3, "hidden": true, "optional": true}, {"id": "o_tally", "kind": "KillTag", "text": "Drive off the Tally", "tag": "tally", "count": 4, "hidden": true, "optional": true}, {"id": "o_vent", "kind": "Undetected", "text": "Through the vent, unseen", "hidden": true, "optional": true}], "triggers": [{"id": "t_sees", "when": {"kind": "Sees", "tag": "cole"}, "actions": [{"kind": "Prompt", "prompt": {"id": "m9_door", "speaker": "Cole Brannigan", "text": "Bunker's full of Husks. My people are tired. Yours look fresh. We clear it together, we split it down the middle. I count, you watch me count.", "options": [{"id": "share", "text": "Together. Half each.", "hint": "Cole will remember this."}, {"id": "take", "text": "It's ours. Walk away.", "hint": "This is a fight."}, {"id": "slip", "text": "(nod, then go round the back)", "hint": "If they see you, it's a fight."}]}}]}, {"id": "t_share", "when": {"kind": "Chosen", "choice": "m9_door:share"}, "actions": [{"kind": "SetSide", "tag": "tally", "side": "party"}, {"kind": "SetSide", "tag": "cole", "side": "party"}, {"kind": "Activate", "objective": "o_husks"}, {"kind": "Flag", "flag": "m9_share", "value": 1}, {"kind": "Flag", "flag": "cole_respect", "value": 2, "add": true}, {"kind": "Flag", "flag": "tally_trader", "value": 1}, {"kind": "Say", "speaker": "Cole Brannigan", "text": "Front room's yours. Back room's ours. Middle's whoever's still standing."}]}, {"id": "t_take", "when": {"kind": "Chosen", "choice": "m9_door:take"}, "actions": [{"kind": "SetSide", "tag": "tally", "side": "hostile"}, {"kind": "SetSide", "tag": "cole", "side": "hostile"}, {"kind": "Activate", "objective": "o_tally"}, {"kind": "Flag", "flag": "m9_take", "value": 1}, {"kind": "Flag", "flag": "cole_respect", "value": -3, "add": true}, {"kind": "Say", "speaker": "Cole Brannigan", "text": "Wrong answer. I'm writing it down."}]}, {"id": "t_slip", "when": {"kind": "Chosen", "choice": "m9_door:slip"}, "actions": [{"kind": "Activate", "objective": "o_vent"}, {"kind": "Flag", "flag": "m9_slip", "value": 1}, {"kind": "Flag", "flag": "cole_respect", "value": -1, "add": true}, {"kind": "Say", "speaker": "Cole Brannigan", "text": "Suit yourself. Door's ours."}]}, {"id": "t_seen", "when": {"kind": "ObjectiveFailed", "objective": "o_vent"}, "actions": [{"kind": "SetSide", "tag": "tally", "side": "hostile"}, {"kind": "SetSide", "tag": "cole", "side": "hostile"}, {"kind": "Activate", "objective": "o_tally"}, {"kind": "Flag", "flag": "m9_take", "value": 1}, {"kind": "Flag", "flag": "cole_respect", "value": -2, "add": true}, {"kind": "Say", "speaker": "Cole Brannigan", "text": "There you are. Vents. Cute."}]}, {"id": "t_cole_hurt", "when": {"kind": "Hurt", "tag": "cole", "below": 0.5}, "actions": [{"kind": "Say", "speaker": "Cole Brannigan", "text": "That's one you owe me. I write it down."}, {"kind": "Leave", "tag": "cole"}]}, {"id": "t_vault", "when": {"kind": "ObjectiveDone", "objective": "o_vault"}, "actions": [{"kind": "Split", "tag": "vault_locker"}, {"kind": "Say", "speaker": "Cole Brannigan", "text": "Half. Count it. I did."}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_riot_armor"}, {"kind": "Schematic", "id": "sch_evac_beacon"}, {"kind": "Schematic", "id": "sch_buggy", "when": {"flag": "m9_share"}}, {"kind": "Fallback", "id": "", "text": "Cole's chassis plan waits for a Garage.", "when": {"flag": "m9_share"}}, {"kind": "SetFlag", "id": "m9_split", "value": 0}], "fail": {"retryDays": 4, "call": "m9_retry"}},
  {"id": "m10", "act": 2, "name": "Ghost Signal", "type": "Field", "main": true, "summary": "A Linked transponder is broadcasting nothing. A Linked unit sits in a flooded store, not moving.", "teaches": "Not every Linked is the enemy; carrying under pressure.", "needsText": "M8", "zone": "flooded_mall", "threat": 2, "map": "generated", "room": "m10_store", "maxParty": 4, "requires": [{"mission": "m8"}], "briefing": "m10_open", "debrief": "m10_close", "field": {"id": "m10", "name": "Ghost Signal", "objectives": [{"id": "o_find", "kind": "Reach", "text": "Find the silent Linked", "marker": "store", "radius": 2}, {"id": "o_chosen", "kind": "Reach", "text": "Decide what to do with it", "marker": "store", "radius": 99, "hidden": true}, {"id": "o_capture", "kind": "Escort", "text": "Bring it home", "tag": "seven", "hidden": true, "optional": true}, {"id": "o_destroy", "kind": "KillTag", "text": "Destroy it", "tag": "seven", "count": 1, "hidden": true, "optional": true}], "triggers": [{"id": "t_sees", "when": {"kind": "Sees", "tag": "seven"}, "actions": [{"kind": "Say", "speaker": "L-0707", "text": "What day is it?"}]}, {"id": "t_near", "when": {"kind": "Enter", "marker": "store", "radius": 3}, "actions": [{"kind": "Prompt", "prompt": {"id": "m10_store", "speaker": "L-0707", "text": "I have a memory of a kitchen. Yellow tiles. Someone singing. Do you know whose kitchen this is?", "options": [{"id": "capture", "text": "Come with us.", "hint": "The Linked will want it back."}, {"id": "free", "text": "Go. You're free.", "hint": "We won't see it again. Probably."}, {"id": "destroy", "text": "(raise your weapon)", "hint": "It won't fight back."}]}}]}, {"id": "t_capture", "when": {"kind": "Chosen", "choice": "m10_store:capture"}, "actions": [{"kind": "Complete", "objective": "o_chosen"}, {"kind": "Activate", "objective": "o_capture"}, {"kind": "Follow", "tag": "seven"}, {"kind": "Flag", "flag": "seven_fate", "value": 1}, {"kind": "Say", "speaker": "L-0707", "text": "Oh. That is quiet. Thank you."}]}, {"id": "t_hunt", "when": {"kind": "After", "objective": "o_capture", "round": 3}, "actions": [{"kind": "Spawn", "enemy": "linked", "count": 2, "marker": "hunt_edge", "tag": "hunt", "goal": "store"}, {"kind": "Say", "speaker": "Lantern", "text": "Two Linked inbound. They want it back. Don't let them have it back."}]}, {"id": "t_lost", "when": {"kind": "ObjectiveFailed", "objective": "o_capture"}, "actions": [{"kind": "Flag", "flag": "seven_fate", "value": 2, "add": true}]}, {"id": "t_free", "when": {"kind": "Chosen", "choice": "m10_store:free"}, "actions": [{"kind": "Complete", "objective": "o_chosen"}, {"kind": "Flag", "flag": "seven_fate", "value": 2}, {"kind": "Say", "speaker": "L-0707", "text": "Then I will go. Here. You might need this more."}, {"kind": "Leave", "tag": "seven"}]}, {"id": "t_destroy", "when": {"kind": "Chosen", "choice": "m10_store:destroy"}, "actions": [{"kind": "Complete", "objective": "o_chosen"}, {"kind": "Activate", "objective": "o_destroy"}, {"kind": "SetSide", "tag": "seven", "side": "hostile"}, {"kind": "Flag", "flag": "seven_fate", "value": 3}, {"kind": "Say", "speaker": "L-0707", "text": "Oh. All right. Will you tell someone about the kitchen?"}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_network_ghost"}, {"kind": "Call", "id": "seven_joins", "value": 168, "when": {"flag": "seven_fate", "min": 1, "max": 1}}, {"kind": "Item", "id": "linked_core", "value": 1, "when": {"flag": "seven_fate", "min": 2, "max": 2}}, {"kind": "Item", "id": "linked_plating", "value": 1, "when": {"flag": "seven_fate", "min": 3, "max": 3}}, {"kind": "ResearchData", "id": "", "value": 6, "when": {"flag": "seven_fate", "min": 3, "max": 3}}, {"kind": "Dies", "id": "seven", "text": "Destroyed in a flooded shoe shop", "when": {"flag": "seven_fate", "min": 3, "max": 3}}], "fail": {}},
