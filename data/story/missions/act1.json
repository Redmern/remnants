  {
    "id": "t_tailor", "act": 1, "name": "Needle and Thread", "type": "Colony", "main": false, "task": true,
    "summary": "Build a Tailor: coats against the cold, cloaks against eyes.",
    "requires": [ { "mission": "m2" } ],
    "colonyObjectives": [ { "id": "build", "kind": "Build", "text": "Build a Tailor", "building": "tailor" } ],
    "rewards": [ { "kind": "Resource", "id": "cloth", "value": 5 } ]
