  {
    "id": "m2", "act": 1, "name": "First Light", "type": "Field",
    "summary": "Iris needs a working antenna to reach farther. A collapsed Network relay shed in the Outskirts still has one.",
    "teaches": "Moving, attacking, AP, looting, extracting; a schematic learned on return.",
    "needsText": "M1 Home",
    "zone": "outskirts", "threat": 1, "map": "handmade:relay_shed",
    "requires": [ { "mission": "m1" } ],
    "briefing": "m2_first_light", "debrief": "m2_debrief",
    "field": {
      "id": "m2", "name": "First Light",
      "objectives": [
        { "id": "reach", "kind": "Reach", "text": "Reach the relay shed", "marker": "shed", "radius": 1 },
        { "id": "antenna", "kind": "Retrieve", "text": "Bring the antenna home", "item": "relay_antenna" }
      ],
      "triggers": [
        { "id": "hello", "when": { "kind": "Round", "round": 1 },
          "actions": [ { "kind": "Say", "speaker": "Lantern", "text": "Husks walk the same loop forever. Watch it once, then go round." } ] },
        { "id": "at_shed", "when": { "kind": "ObjectiveDone", "objective": "reach" },
          "actions": [ { "kind": "Say", "speaker": "Lantern", "text": "That's the shed. Antenna should be in the back, in a crate. Grab it." } ] },
        { "id": "pulled", "when": { "kind": "PickedUp", "item": "relay_antenna" },
          "actions": [
            { "kind": "Say", "speaker": "Lantern", "text": "Got it? Great. That noise was you, by the way. Go." },
            { "kind": "Spawn", "enemy": "husk", "count": 1, "marker": "shed_back", "tag": "woken", "goal": "shed" }
          ] }
      ]
    },
    "rewards": [
      { "kind": "Schematic", "id": "sch_watchtower" },
      { "kind": "RevealZone", "id": "suburb_ruins", "text": "Radio range now covers Ashgrove" },
      { "kind": "Resource", "id": "medicine", "value": 3 },
      { "kind": "Item", "id": "relay_antenna", "value": -1 },
      { "kind": "SetFlag", "id": "radio_range", "value": 2 }
    ],
    "fail": {
      "retryDays": 3, "call": "m2_retry",
      "extraEnemies": [ { "enemy": "husk", "marker": "shed_back" }, { "enemy": "husk", "marker": "antenna" } ]
    }
  },
  {
    "id": "t_med_bay", "act": 1, "name": "A Place to Heal", "type": "Colony", "main": false, "task": true,
    "summary": "Iris: people get hurt out there. Build a Med Bay before you need one.",
    "requires": [ { "mission": "m2" } ],
    "colonyObjectives": [ { "id": "build", "kind": "Build", "text": "Build a Med Bay", "building": "med_bay" } ],
    "rewards": [ { "kind": "Resource", "id": "medicine", "value": 2 } ]
  },
  {
    "id": "t_bandages", "act": 1, "name": "Clean Cloth", "type": "Colony", "main": false, "task": true,
    "summary": "Keep bandages in stock. The Tailor or the Workshop can make them; have five on the shelf.",
    "requires": [ { "mission": "m2" } ],
    "colonyObjectives": [ { "id": "bandages", "kind": "HaveItem", "text": "Have 5 bandages", "item": "bandage", "count": 5 } ],
    "rewards": [ { "kind": "Resource", "id": "cloth", "value": 5 } ]
  },
  {
    "id": "t_patient", "act": 1, "name": "Bed Rest", "type": "Colony", "main": false, "task": true,
    "summary": "A wound left alone gets worse. Admit someone hurt to the Med Bay.",
    "requires": [ { "mission": "t_med_bay" } ],
    "colonyObjectives": [ { "id": "admit", "kind": "Patient", "text": "Admit a patient to the Med Bay" } ],
