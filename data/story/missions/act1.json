  {
    "id": "m3", "act": 1, "name": "Signal in the Rust", "type": "Field",
    "summary": "A terminal is pinging out in the Scrapyard Flats. Iris will talk you through the hack. Someone else heard it too.",
    "teaches": "Hacking, chance, alarms and lockouts; a non-hostile human side.",
    "needsText": "M2 First Light, a Workshop",
    "zone": "scrapyard_flats", "threat": 1, "map": "generated", "room": "scrapyard_terminal",
    "requires": [ { "mission": "m2" }, { "building": "workshop" } ],
    "briefing": "m3_brief", "debrief": "m3_debrief",
    "field": {
      "id": "m3", "name": "Signal in the Rust",
      "objectives": [
        { "id": "locker", "kind": "Hack", "text": "Hack the locker", "tag": "locker" },
        { "id": "terminal", "kind": "Hack", "text": "Hack the marked terminal", "tag": "terminal", "failsMission": true },
        { "id": "tally", "kind": "Reach", "text": "Deal with the Tally", "marker": "none", "optional": true, "hidden": true }
      ],
      "triggers": [
        { "id": "hello", "when": { "kind": "Round", "round": 1 },
          "actions": [ { "kind": "Say", "speaker": "Lantern", "text": "There's a toolbox in the terminal room. Kit inside. Take it before you touch anything." } ] },
        { "id": "kit", "when": { "kind": "PickedUp", "item": "hacking_kit" },
          "actions": [ { "kind": "Say", "speaker": "Lantern", "text": "Start with the locker. Easy one. Stand next to it and hack." } ] },
        { "id": "locker_done", "when": { "kind": "ObjectiveDone", "objective": "locker" },
          "actions": [ { "kind": "Say", "speaker": "Lantern", "text": "See? Now the terminal. It's on the Network, so it bites back if you fumble." } ] },
        { "id": "alarm", "when": { "kind": "Alarm" },
          "actions": [ { "kind": "Say", "speaker": "Lantern", "text": "Ow. That's a lockout. Wait it out, breathe, try again." } ] },
        { "id": "tally_come", "when": { "kind": "Round", "round": 4 },
          "actions": [
            { "kind": "Spawn", "enemy": "cole", "count": 1, "marker": "tally_in", "tag": "tally", "side": "neutral" },
            { "kind": "Spawn", "enemy": "tally_scav", "count": 1, "marker": "tally_in", "tag": "tally", "side": "neutral" },
            { "kind": "Say", "speaker": "Lantern", "text": "Company. Two of them, human. Don't shoot first." }
          ] },
        { "id": "tally_seen", "when": { "kind": "Sees", "tag": "tally" },
          "actions": [
            { "kind": "Activate", "objective": "tally" },
            { "kind": "Flag", "flag": "cole_met", "value": 1 },
            { "kind": "Prompt", "prompt": {
              "id": "tally", "speaker": "Cole Brannigan",
              "text": "Easy. Easy. That terminal's been pinging for a week and we've been walking toward it for six days. Call it a draw? We split what's in it. Or we don't, and I write your names down.",
              "options": [
                { "id": "talk", "text": "Split it. Nobody needs to bleed over a box.", "hint": "Cole will remember this" },
                { "id": "fight", "text": "We were here first. Walk away.", "hint": "This becomes a fight" },
                { "id": "leave", "text": "Say nothing. Finish the hack and go." }
              ] } }
          ] },
        { "id": "talked", "when": { "kind": "Chosen", "choice": "tally:talk" },
          "actions": [
            { "kind": "Flag", "flag": "cole_respect", "value": 1, "add": true },
            { "kind": "Split", "tag": "terminal" },
            { "kind": "Complete", "objective": "tally" },
            { "kind": "Say", "speaker": "Cole Brannigan", "text": "That's one you owe me. I write it down. I write everything down." }
          ] },
        { "id": "fought", "when": { "kind": "Chosen", "choice": "tally:fight" },
          "actions": [
            { "kind": "Flag", "flag": "cole_respect", "value": -1, "add": true },
            { "kind": "SetSide", "tag": "tally", "side": "hostile" },
            { "kind": "Complete", "objective": "tally" },
            { "kind": "Say", "speaker": "Cole Brannigan", "text": "Your call. I'll remember who made it." }
          ] },
        { "id": "left", "when": { "kind": "Chosen", "choice": "tally:leave" },
          "actions": [
            { "kind": "Complete", "objective": "tally" },
            { "kind": "Say", "speaker": "Cole Brannigan", "text": "Quiet type. Fine. Tick tock." }
          ] }
      ]
    },
    "rewards": [
      { "kind": "Schematic", "id": "sch_camo_cloak" },
      { "kind": "Item", "id": "hacking_kit", "value": 1 },
      { "kind": "Character", "id": "cole", "value": 1, "when": { "flag": "cole_met" } }
    ],
    "fail": { "retryDays": 4, "call": "m3_retry" }
  },
  {
    "id": "m4", "act": 1, "name": "The Stranger", "type": "Field",
    "summary": "A wounded scout is hiding in a house in the Suburb Ruins. The Husks around it have gone still in the fog.",
    "teaches": "Fog, Lookout, flares, ambushes; treating and escorting someone home. Vehicles exist.",
    "needsText": "M3 Signal in the Rust, Town Hall, a Med Bay",
    "zone": "suburb_ruins", "threat": 2, "map": "generated", "room": "ruins_house",
    "requires": [ { "mission": "m3" }, { "townHall": 1 }, { "building": "med_bay" } ],
    "briefing": "m4_brief", "debrief": "m4_debrief",
    "field": {
      "id": "m4", "name": "The Stranger", "excludeEnemyTags": ["network"],
      "objectives": [
        { "id": "find", "kind": "Reach", "text": "Find the scout", "marker": "scout", "radius": 2 },
        { "id": "aid", "kind": "Aid", "text": "Stabilise her (bandage or med-kit)", "tag": "juniper", "failsMission": true },
        { "id": "escort", "kind": "Escort", "text": "Get Juniper out alive", "tag": "juniper", "failsMission": true }
      ],
      "triggers": [
        { "id": "hello", "when": { "kind": "Round", "round": 1 },
          "actions": [ { "kind": "Say", "speaker": "Lantern", "text": "Fog's thick in the Ruins. Use Lookout before you walk into anything. Flares if you have them." } ] },
        { "id": "found", "when": { "kind": "ObjectiveDone", "objective": "find" },
          "actions": [ { "kind": "Say", "speaker": "Juniper", "text": "Don't — okay. You're not Linked. You're not Linked, right? My leg. I can't walk on it." } ] },
        { "id": "aided", "when": { "kind": "ObjectiveDone", "objective": "aid" },
          "actions": [
            { "kind": "Follow", "tag": "juniper" },
            { "kind": "Say", "speaker": "Juniper", "text": "Thanks. Juniper. I ride for Marrow. He'll pay you back. He always does." },
            { "kind": "Spawn", "enemy": "husk_crawler", "count": 1, "marker": "scout", "tag": "ambush", "goal": "scout" },
            { "kind": "Say", "speaker": "Lantern", "text": "Movement. They were waiting for her to move. Go, go." }
          ] },
        { "id": "lost", "when": { "kind": "ObjectiveFailed", "objective": "escort" },
          "actions": [ { "kind": "Say", "speaker": "Lantern", "text": "...She's gone. I'm sorry. Get yourselves out." } ] }
      ]
    },
    "rewards": [
      { "kind": "Schematic", "id": "sch_bicycle_cart" },
      { "kind": "Vehicle", "id": "handcart" },
      { "kind": "Item", "id": "manual_electronics", "value": 1 },
      { "kind": "SetFlag", "id": "caravan_open", "value": 1 },
      { "kind": "Character", "id": "juniper", "value": 1 },
      { "kind": "Character", "id": "marrow", "value": 1 },
      { "kind": "Call", "id": "marrow_hello", "value": 48 }
    ],
    "fail": {
      "call": "m4_failed",
      "effects": [
        { "kind": "SetFlag", "id": "caravan_open", "value": 1 },
        { "kind": "SetFlag", "id": "marrow_grieving", "value": 1 },
        { "kind": "Character", "id": "marrow", "value": 1 },
        { "kind": "Call", "id": "marrow_grief", "value": 96 }
      ]
    }
  },
  {
    "id": "t_town_hall", "act": 1, "name": "Room to Grow", "type": "Colony", "main": false, "task": true,
