  },
  {
    "id": "t_fence", "act": 1, "name": "The Fence Line", "type": "Colony", "main": false, "task": true,
    "summary": "Iris: the radio carries, and not only to friends. Raiders will find you before long. A Lookout Tower sees them coming and spike strips slow them down.",
    "requires": [ { "mission": "m2" } ],
    "colonyObjectives": [
      { "id": "tower", "kind": "Defense", "text": "Put up a Lookout Tower", "defense": "Tower" },
      { "id": "traps", "kind": "Defense", "text": "Lay two spike strips", "defense": "Trap", "count": 2 }
    ],
    "rewards": [ { "kind": "Schematic", "id": "sch_barricade" }, { "kind": "Resource", "id": "scrap", "value": 8 } ]
  },
  {
    "id": "m5", "act": 1, "name": "Hold the Line", "type": "Field",
    "summary": "The radio mast is loud. Something heard it. A Husk swarm is walking in from the treeline at dusk.",
    "teaches": "Overwatch, Brace, defending the colony; why the Watchtower matters.",
    "needsText": "M4 The Stranger, Town Hall 2",
    "zone": "outskirts", "threat": 2, "map": "perimeter", "maxParty": 4,
    "requires": [ { "mission": "m4" }, { "townHall": 2 } ],
    "briefing": "m5_brief", "debrief": "m5_debrief",
    "field": {
      "id": "m5", "name": "Hold the Line", "atHome": true,
      "objectives": [
        { "id": "survive", "kind": "Survive", "text": "Survive 8 rounds", "count": 8 },
        { "id": "mast", "kind": "Defend", "text": "Keep the Radio Mast standing", "tag": "mast", "failsMission": true }
      ],
      "triggers": [
        { "id": "w1", "when": { "kind": "Round", "round": 1 },
          "actions": [
            { "kind": "Say", "speaker": "Lantern", "text": "They're coming for the mast. It's the loudest thing for miles. Put someone on overwatch." },
            { "kind": "Spawn", "enemy": "husk", "count": 3, "marker": "treeline", "tag": "swarm", "goal": "mast" }
          ] },
        { "id": "w2", "when": { "kind": "Round", "round": 4 },
          "actions": [
            { "kind": "Say", "speaker": "Lantern", "text": "Second wave. Brace if you're in the open." },
            { "kind": "Spawn", "enemy": "husk", "count": 3, "marker": "treeline", "tag": "swarm", "goal": "mast" },
            { "kind": "Spawn", "enemy": "husk_crawler", "count": 1, "marker": "treeline", "tag": "swarm", "goal": "mast" }
          ] },
        { "id": "w3", "when": { "kind": "Round", "round": 6 },
          "actions": [
            { "kind": "Say", "speaker": "Lantern", "text": "Last of them. I think. Hold on." },
            { "kind": "Spawn", "enemy": "husk", "count": 3, "marker": "treeline", "tag": "swarm", "goal": "mast" },
            { "kind": "Spawn", "enemy": "husk_crawler", "count": 2, "marker": "treeline", "tag": "swarm", "goal": "mast" }
          ] },
        { "id": "mast_hit", "when": { "kind": "ObjectiveFailed", "objective": "mast" },
          "actions": [ { "kind": "Say", "speaker": "Lantern", "text": "—lost the mast — I'm — " } ] }
      ]
    },
    "rewards": [
      { "kind": "Schematic", "id": "sch_workshop_3" },
      { "kind": "ResearchData", "value": 6 },
      { "kind": "Schematic", "id": "sch_sandbag_nest" },
      { "kind": "Resource", "id": "wood", "value": 12 },
      { "kind": "Resource", "id": "scrap", "value": 8 },
      { "kind": "Note", "text": "Marrow sends a barricade kit for the next time: wood and scrap for four barricades, and how to stack a sandbag nest." },
      { "kind": "SetFlag", "id": "act", "value": 2 },
      { "kind": "Note", "text": "End of Act 1: Static." }
    ],
    "fail": {
      "retryDays": 5, "call": "m5_failed",
      "effects": [
        { "kind": "SetFlag", "id": "iris_off_air", "value": 1 },
        { "kind": "Note", "text": "The Radio Mast went down. Iris is off the air for 5 days while it's patched." }
      ]
    }
  }
]
