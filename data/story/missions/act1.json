    "briefing": "m1_home",
    "colonyObjectives": [
      { "id": "farm", "kind": "Build", "text": "Build a Farm", "building": "farm" },
      { "id": "woodcutter", "kind": "Build", "text": "Build a Woodcutter", "building": "woodcutter" },
      { "id": "workshop", "kind": "Build", "text": "Build a Workshop", "building": "workshop" },
      { "id": "mast", "kind": "Build", "text": "Build the Radio Mast", "building": "radio_mast" },
      { "id": "tune", "kind": "Scene", "text": "Pell tunes the radio at dusk", "dialogue": "m1_tuning", "phase": "Dusk" }
    ],
    "rewards": [
      { "kind": "SetFlag", "id": "iris_channel", "value": 1 },
      { "kind": "Character", "id": "iris", "value": 1 },
      { "kind": "Resource", "id": "scrap", "value": 10 }
    ]
