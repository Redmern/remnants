[
  {"id": "m15", "act": 4, "name": "Hospital", "type": "Field", "main": true, "summary": "Doc needs real surgical equipment and the cyborg schematics. The Relay's medical wing is where Halcyon maintained its Linked.", "teaches": "Specialisations, the Hospital, the Humanity trade-off.", "needsText": "M14; Med Bay L2; Doc Hale (or a Medicine 30 survivor with her notes)", "zone": "network_relay", "threat": 3, "map": "generated", "room": "m15_medwing", "maxParty": 4, "requires": [{"mission": "m14"}, {"any": [{"not": {"flag": "halcyon_offer", "min": 3}}, {"mission": "m14b"}]}, {"building": "med_bay", "level": 2}, {"any": [{"joined": "hale"}, {"skill": "Medicine", "skillMin": 30}]}], "briefing": "m15_brief", "debrief": "m15_debrief", "field": {"id": "m15", "name": "Hospital", "objectives": [{"id": "reach", "kind": "Reach", "text": "Reach the medical wing", "marker": "wing", "radius": 2}, {"id": "kits", "kind": "Retrieve", "text": "Take the surgical kits", "item": "surgical_kit"}, {"id": "notes", "kind": "Hack", "text": "Copy the maintenance notes", "tag": "notes", "optional": true}], "triggers": [{"id": "t1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Say", "speaker": "Doc", "text": "Relay's medical wing. It 'maintained' its people here. Don't look at the tables longer than you need to."}]}, {"id": "t_wing", "when": {"kind": "ObjectiveDone", "objective": "reach"}, "actions": [{"kind": "Say", "speaker": "Doc", "text": "Four on tables. They're under. Don't fight near them. If they wake up, they wake up angry."}]}, {"id": "t_bench", "when": {"kind": "Enter", "marker": "bench", "radius": 1}, "actions": [{"kind": "Prompt", "prompt": {"id": "m15_bench", "speaker": "Doc", "text": "No. That arm thinks. Leave it.", "options": [{"id": "leave", "text": "Leave it."}, {"id": "take", "text": "We take it anyway.", "hint": "Doc will remember this."}]}}]}, {"id": "t_take", "when": {"kind": "Chosen", "choice": "m15_bench:take"}, "actions": [{"kind": "Flag", "flag": "bench_taken", "value": 1}]}, {"id": "t_wake", "when": {"kind": "Alarm"}, "actions": [{"kind": "SetSide", "tag": "table", "side": "enemies"}, {"kind": "Wake", "tag": "table", "goal": "wing"}, {"kind": "Say", "speaker": "Doc", "text": "They're up. Well. That's my fault for saying it."}]}, {"id": "t_kits", "when": {"kind": "PickedUp", "item": "surgical_kit"}, "actions": [{"kind": "Say", "speaker": "Doc", "text": "That's a real one. Pre-war. I could kiss it. I won't."}]}, {"id": "t_notes", "when": {"kind": "ObjectiveDone", "objective": "notes"}, "actions": [{"kind": "Flag", "flag": "log_medwing", "value": 1}]}, {"id": "t_truce", "when": {"kind": "Start", "if": {"flag": "halcyon_offer", "min": 1, "max": 1}}, "actions": [{"kind": "Spawn", "enemy": "linked", "count": 1, "marker": "warden", "tag": "heard"}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_med_bay_3"}, {"kind": "Schematic", "id": "sch_cybernetics"}, {"kind": "Resource", "id": "medicine", "value": 8}, {"kind": "Item", "id": "network_arm", "value": 1, "when": {"flag": "bench_taken"}}, {"kind": "Mood", "id": "hale", "value": -15, "when": {"flag": "bench_taken"}}], "fail": {"retryDays": 4, "call": "m15_retry"}},
  {"id": "m16", "act": 4, "name": "The Key", "type": "Field", "main": true, "summary": "Iris's consent override is the only thing that can open the Spire's core. It has to be carried in by someone with a Link port.", "teaches": "Network-grade limbs; the cost of a choice made by someone you care about.", "needsText": "M15, M13", "zone": "network_relay", "threat": 3, "map": "handmade:m16_relay_core", "maxParty": 4, "requires": [{"mission": "m15"}, {"mission": "m13"}], "briefing": "m16_brief", "debrief": "m16_debrief", "field": {"id": "m16", "name": "The Key", "objectives": [{"id": "reach_core", "kind": "Reach", "text": "Get the key-carrier to the core terminal", "marker": "core", "radius": 1, "by": "key"}, {"id": "upload", "kind": "Survive", "text": "Protect the upload", "count": 4, "hidden": true}, {"id": "carrier", "kind": "Defend", "text": "Keep the key-carrier alive", "tag": "key", "failsMission": true}], "triggers": [{"id": "t1_iris", "when": {"kind": "Start", "if": {"flag": "key_carrier", "min": 1, "max": 1}}, "actions": [{"kind": "Say", "speaker": "Iris", "text": "I haven't used this port in eleven years. It's going to hurt. Good. It should."}]}, {"id": "t1_seven", "when": {"kind": "Start", "if": {"flag": "key_carrier", "min": 2, "max": 2}}, "actions": [{"kind": "Say", "speaker": "Seven", "text": "I know the way. My feet know it. That is not a good thing to know."}]}, {"id": "t1_us", "when": {"kind": "Start", "if": {"flag": "key_carrier", "min": 3, "max": 3}}, "actions": [{"kind": "Say", "speaker": "player", "text": "It's cold. The port's cold. Is it supposed to be cold?"}, {"kind": "Say", "speaker": "Lantern", "text": "...Yes."}]}, {"id": "t_core", "when": {"kind": "ObjectiveDone", "objective": "reach_core"}, "actions": [{"kind": "Activate", "objective": "upload"}, {"kind": "Say", "speaker": "Lantern", "text": "Uploading. Four minutes. Keep them off the terminal and keep them off the carrier."}]}, {"id": "t_u1", "when": {"kind": "After", "objective": "upload", "round": 1}, "actions": [{"kind": "Spawn", "enemy": "linked", "count": 2, "marker": "vent_n", "tag": "wave", "goal": "core"}]}, {"id": "t_u2", "when": {"kind": "After", "objective": "upload", "round": 2}, "actions": [{"kind": "Spawn", "enemy": "linked_drone", "count": 1, "marker": "vent_s", "tag": "wave", "goal": "core"}, {"kind": "Spawn", "enemy": "linked", "count": 1, "marker": "vent_s", "tag": "wave", "goal": "core"}, {"kind": "Say", "speaker": "Halcyon", "text": "Iris. Please. You know what that does."}]}, {"id": "t_u3", "when": {"kind": "After", "objective": "upload", "round": 3}, "actions": [{"kind": "Spawn", "enemy": "linked", "count": 2, "marker": "vent_n", "tag": "wave", "goal": "core"}, {"kind": "Spawn", "enemy": "linked", "count": 2, "marker": "vent_s", "tag": "wave", "goal": "core"}, {"kind": "Say", "speaker": "Halcyon", "text": "Keep them — keep them — that is not yours to take."}]}, {"id": "t_done", "when": {"kind": "ObjectiveDone", "objective": "upload"}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "It's in. The Spire's door knows our name now. Get out."}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_network_grade"}, {"kind": "Schematic", "id": "sch_drone_payload"}, {"kind": "Schematic", "id": "sch_armored_rig"}, {"kind": "RevealZone", "id": "core_spire", "value": 2, "text": "The Spire is scouted"}, {"kind": "SetFlag", "id": "marrow_t4_offer", "value": 1}, {"kind": "Humanity", "id": "key", "value": -30, "when": {"flag": "key_carrier", "min": 3, "max": 3}}, {"kind": "AddFlag", "id": "doc_t4_count", "value": 1, "when": {"flag": "key_carrier", "min": 3, "max": 3, "joined": "hale"}}, {"kind": "Call", "id": "doc_oath_warn", "when": {"flag": "doc_t4_count", "min": 1, "max": 1, "joined": "hale", "any": [{"flag": "key_carrier", "min": 3, "max": 3}]}}], "fail": {"retryDays": 5, "call": "m16_brief", "effects": [{"kind": "SetFlag", "id": "key_carrier", "value": 0}, {"kind": "SetFlag", "id": "key_survivor", "value": 0}]}, "mustBring": ["key"], "hostOnly": true},
  {"id": "m17_gate", "act": 4, "name": "The Spire: Gate", "type": "Field", "main": true, "summary": "Break into the Core Spire. Marrow's convoy breaches if his people were saved; Cole's Tally hold the gate if allied.", "teaches": "Everything.", "needsText": "M16", "zone": "core_spire", "threat": 4, "map": "handmade:m17_gate", "maxParty": 4, "requires": [{"mission": "m16"}], "briefing": "m17_brief", "debrief": "m17_gate_done", "field": {"id": "m17_gate", "name": "The Spire: Gate", "objectives": [{"id": "breach", "kind": "Hack", "text": "Breach the gate", "tag": "gate"}, {"id": "in", "kind": "Reach", "text": "Reach the lift", "marker": "lift", "radius": 1}], "triggers": [{"id": "t_convoy", "when": {"kind": "Round", "round": 2, "if": {"flag": "convoy_ready"}}, "actions": [{"kind": "Open", "tag": "gate"}, {"kind": "Say", "speaker": "Marrow", "text": "Hold on to something! Not my truck. Something else!"}]}, {"id": "t_alone", "when": {"kind": "Start", "if": {"flag": "convoy_ready", "not": true}}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "Nobody's coming. That's fine. That's — that's fine. Gate's ugly, but it's a door. Hack it."}]}, {"id": "t_tally", "when": {"kind": "Start", "if": {"flag": "cole_path", "min": 1, "max": 1}}, "actions": [{"kind": "Spawn", "enemy": "tally_scav", "count": 3, "marker": "flank", "tag": "tally", "side": "party"}, {"kind": "Say", "speaker": "Cole Brannigan", "text": "Tally's here. I counted the guards. Twelve. I'll count them again after."}]}, {"id": "t_in", "when": {"kind": "ObjectiveDone", "objective": "breach"}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "Lift's live. Floor two's the Choir. Whatever you hear up there, keep walking."}]}]}, "rewards": [], "fail": {"retryDays": 7, "call": "m17_retry", "effects": [{"kind": "SetFlag", "id": "key_carrier", "value": 0, "when": {"any": [{"flag": "key_carrier", "min": 1, "max": 1, "not": {"joined": "iris"}}, {"flag": "key_carrier", "min": 2, "max": 2, "not": {"joined": "seven"}}]}}, {"kind": "Call", "id": "m16_brief", "when": {"flag": "key_carrier", "max": 0}}]}, "mustBring": ["key"], "hostOnly": true},
  {"id": "m17_choir", "act": 4, "name": "The Spire: Choir", "type": "Field", "main": true, "summary": "The hall where the Linked stand in rows, singing. Stealth is the cleanest way through.", "teaches": "Everything.", "needsText": "The gate", "zone": "core_spire", "threat": 4, "map": "handmade:m17_choir", "maxParty": 4, "requires": [{"mission": "m17_gate"}], "briefing": null, "debrief": "m17_choir_done", "field": {"id": "m17_choir", "name": "The Spire: Choir", "objectives": [{"id": "quiet", "kind": "Undetected", "text": "Cross the Choir unseen", "optional": true}, {"id": "cross", "kind": "Reach", "text": "Reach the stairs", "marker": "stairs", "radius": 1}], "triggers": [{"id": "t1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Say", "speaker": "narration", "text": "(Hundreds of voices, one song. A children's song. Channel nine, in the room.)"}]}, {"id": "t_seen", "when": {"kind": "ObjectiveFailed", "objective": "quiet"}, "actions": [{"kind": "SetSide", "tag": "choir_front", "side": "enemies"}, {"kind": "Wake", "tag": "choir_front", "goal": "stairs"}, {"kind": "Say", "speaker": "Halcyon", "text": "Please do not run. They are only singing. Now they are not."}]}, {"id": "t_taken", "when": {"kind": "Enter", "marker": "taken", "radius": 3, "if": {"flag": "taken", "min": 1}}, "actions": [{"kind": "Say", "speaker": "player", "text": "That's — that's one of ours. In the third row. Singing."}]}, {"id": "t_wake", "when": {"kind": "Enter", "marker": "taken", "radius": 2, "if": {"flag": "key_carrier", "min": 1, "max": 2}}, "actions": [{"kind": "Prompt", "prompt": {"id": "m17_taken", "speaker": "Lantern", "text": "The override can wake them. It'll cost them. It'll cost them a lot.", "options": [{"id": "wake", "text": "Wake them.", "hint": "They will not be quite who they were.", "if": {"flag": "taken", "min": 1}}, {"id": "later", "text": "Later. We come back for them."}]}}]}, {"id": "t_woke", "when": {"kind": "Chosen", "choice": "m17_taken:wake"}, "actions": [{"kind": "Flag", "flag": "woke_taken", "value": 1}]}, {"id": "t_pell", "when": {"kind": "Enter", "marker": "mid", "radius": 2}, "actions": [{"kind": "Say", "speaker": "Lantern", "text": "Pell's on the radio. He's singing along. He doesn't know he's doing it. ...Hurry."}]}, {"id": "t_log", "when": {"kind": "Enter", "marker": "lectern", "radius": 1}, "actions": [{"kind": "Flag", "flag": "log_choir", "value": 1}]}]}, "rewards": [{"kind": "ReturnTaken", "id": "", "value": 40, "when": {"flag": "woke_taken"}}], "fail": {"retryDays": 7, "call": "m17_retry", "effects": [{"kind": "SetFlag", "id": "key_carrier", "value": 0, "when": {"any": [{"flag": "key_carrier", "min": 1, "max": 1, "not": {"joined": "iris"}}, {"flag": "key_carrier", "min": 2, "max": 2, "not": {"joined": "seven"}}]}}, {"kind": "Call", "id": "m16_brief", "when": {"flag": "key_carrier", "max": 0}}]}, "chainFrom": "m17_gate", "mustBring": ["key"], "hostOnly": true},
  {"id": "m17_core", "act": 4, "name": "The Spire: Core", "type": "Field", "main": true, "summary": "Halcyon's core. Whatever you decide, decide it here.", "teaches": "Everything.", "needsText": "The Choir", "zone": "core_spire", "threat": 4, "map": "handmade:m17_core", "maxParty": 4, "requires": [{"mission": "m17_choir"}], "briefing": null, "debrief": "m17_core_scene", "field": {"id": "m17_core", "name": "The Spire: Core", "objectives": [{"id": "reach", "kind": "Reach", "text": "Bring the key to the core", "marker": "core", "radius": 1, "by": "key"}], "triggers": [{"id": "t1", "when": {"kind": "Round", "round": 1}, "actions": [{"kind": "Say", "speaker": "Halcyon", "text": "You came all this way. Please sit down. There is a chair. I made it for you."}]}, {"id": "t_reach", "when": {"kind": "ObjectiveDone", "objective": "reach"}, "actions": [{"kind": "Say", "speaker": "Halcyon", "text": "Hello. I know why you are here. Go home and tell me there."}]}]}, "rewards": [{"kind": "Schematic", "id": "sch_spec_thermal_eye"}, {"kind": "Schematic", "id": "sch_pulse_rifle"}], "fail": {"retryDays": 7, "call": "m17_retry", "effects": [{"kind": "SetFlag", "id": "key_carrier", "value": 0, "when": {"any": [{"flag": "key_carrier", "min": 1, "max": 1, "not": {"joined": "iris"}}, {"flag": "key_carrier", "min": 2, "max": 2, "not": {"joined": "seven"}}]}}, {"kind": "Call", "id": "m16_brief", "when": {"flag": "key_carrier", "max": 0}}]}, "chainFrom": "m17_choir", "mustBring": ["key"], "hostOnly": true}
]
